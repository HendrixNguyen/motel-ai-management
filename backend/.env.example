# Copy to .env and fill in. Never commit .env.
# Every var here is read by backend/src/env.ts and the app refuses to boot if a
# required var is missing or malformed.

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database ------------------------------------------------------------
# PostgreSQL connection string used by Drizzle (postgres-js).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/motel
# Throwaway database. The test suite drops and recreates its schema before each
# test, so never point this at a database holding data you care about.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/motel_test

# --- Auth secrets --------------------------------------------------------
# Generate each with: openssl rand -base64 48
# Rotating MANAGER_JWT_SECRET invalidates all manager sessions.
# Rotating RENTER_SESSION_SECRET invalidates all renter portal sessions.
MANAGER_JWT_SECRET=
RENTER_SESSION_SECRET=

# --- File storage (Cloudflare R2, S3-compatible) -------------------------
# Bucket must be private; objects are served via short-lived signed URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=motel-uploads
R2_PUBLIC_URL=

# --- Zalo Official Account ----------------------------------------------
# Credentials come from the Zalo OA console. The app boots without them but
# every send fails closed with EXTERNAL_SERVICE_ERROR.
ZALO_OA_ID=
ZALO_OA_SECRET=
ZALO_ACCESS_TOKEN=
ZALO_WEBHOOK_SECRET=

# --- ZNS template ids ----------------------------------------------------
# Assigned by Zalo after template approval. Values below are PLACEHOLDERS:
# sending a ZNS message while a template id is still a placeholder is a
# configuration error, not a silent success.
ZNS_TEMPLATE_WELCOME=PLACEHOLDER
ZNS_TEMPLATE_BILL=PLACEHOLDER
ZNS_TEMPLATE_PAYMENT_CONFIRMED=PLACEHOLDER
ZNS_TEMPLATE_CONTRACT=PLACEHOLDER
ZNS_TEMPLATE_OTP=PLACEHOLDER
ZNS_TEMPLATE_EXPIRY=PLACEHOLDER
ZNS_TEMPLATE_TICKET=PLACEHOLDER

# --- Frontend (NEXT_PUBLIC_* are exposed to the browser) -----------------
# Only these two are safe in the browser bundle; secrets never belong here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_RENTER_LINK_TTL_HOURS=24
