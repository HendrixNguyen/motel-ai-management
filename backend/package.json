{
  "name": "backend",
  "version": "1.0.50",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage --parallel=1",
    "start": "bun run src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "start:migration-job": "bun run db:migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "latest",
    "@elysiajs/jwt": "latest",
    "@sinclair/typebox": "^0.34.52",
    "@types/web-push": "^3.6.4",
    "drizzle-orm": "latest",
    "elysia": "latest",
    "postgres": "latest",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "latest",
    "c8": "^12.0.0",
    "drizzle-kit": "latest",
    "typescript": "^5"
  },
  "module": "src/index.js"
}